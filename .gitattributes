# Normalise line endings.
#
# This matters beyond tidiness: the repository is authored on Windows but the
# shell scripts run on Linux, both in GitHub Actions and -- via the user-data
# template -- on every EC2 instance at boot. A CRLF checkout would produce
# "bad interpreter: /usr/bin/env bash^M" and leave instances failing their
# health checks.
* text=auto eol=lf

*.sh        text eol=lf
*.tftpl     text eol=lf
*.tf        text eol=lf
*.tfvars    text eol=lf
*.hcl       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.rego      text eol=lf
*.go        text eol=lf
*.md        text eol=lf

# PowerShell is the one place CRLF is the native convention.
*.ps1       text eol=crlf

# Never touch binaries.
*.png       binary
*.jpg       binary
*.gif       binary
*.pdf       binary
*.ico       binary
